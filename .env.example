# API key for protecting FastAPI endpoints (X-API-KEY header)
API_KEY=change_me_to_a_strong_secret

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Server host/port (used when running without Docker)
HOST=0.0.0.0
PORT=8000

# ngrok settings (for docker-compose setup)
NGROK_DOMAIN=your-subdomain.ngrok-free.app
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Enable Whisper as 3rd transcription fallback (off by default).
# Requires: pip install openai-whisper + ffmpeg in PATH.
# Warning: much slower than subtitle-based methods (downloads audio + local inference).
WHISPER_ENABLED=false
